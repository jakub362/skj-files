[Desktop Entry]
Type=Application
Name=SKJ Files
Name[pl]=SKJ Files
GenericName=File Manager
GenericName[pl]=Menedżer plików
Comment=Fast, good-looking file manager
Comment[pl]=Szybki, ładny menedżer plików
