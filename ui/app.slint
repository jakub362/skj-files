export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> armed;
    in-out property <bool> show;
}

// Kinds: 0 folder · 1 file · 2 image · 3 video · 4 audio · 5 archive · 6 code · 7 text · 8 sheet
// 9 app · 10 disc image · 11 pdf · 12 link · 13 drive · 14 usb · 15 home · 16 desktop · 17 downloads
// 18 pictures · 19 music · 20 videos · 21 documents · 22 user · 23 cloud · 24 trash · 25 recent · 26 search
// Menu-only: 30 open · 31 cut · 32 copy · 33 paste · 34 rename · 35 delete · 36 new folder · 37 new file
// 38 terminal · 39 properties · 40 pin · 41 copy path · 42 new tab · 43 refresh · 44 eye · 46 settings
// 47 folder from selection · 48 sort · 49 grid · 50 list · 51 open with
export global K {
    public pure function icon(k: int) -> image {
        return k == 0 ? Icons.folder : k == 2 ? Icons.file-image : k == 3 ? Icons.file-video : k == 4 ? Icons.file-music
            : k == 5 ? Icons.file-archive : k == 6 ? Icons.file-code : k == 7 ? Icons.file-text : k == 8 ? Icons.file-sheet
            : k == 9 ? Icons.app-window : k == 10 ? Icons.disc : k == 11 ? Icons.file-text : k == 12 ? Icons.link
            : k == 13 ? Icons.hard-drive : k == 14 ? Icons.usb : k == 15 ? Icons.house : k == 16 ? Icons.monitor
            : k == 17 ? Icons.download : k == 18 ? Icons.image : k == 19 ? Icons.music : k == 20 ? Icons.film
            : k == 21 ? Icons.file-text : k == 22 ? Icons.user : k == 23 ? Icons.cloud : k == 24 ? Icons.trash
            : k == 25 ? Icons.clock : k == 26 ? Icons.search : k == 27 ? Icons.tag : k == 28 ? Icons.server : k == 29 ? Icons.plug
            : k == 30 ? Icons.open : k == 31 ? Icons.cut : k == 32 ? Icons.copy : k == 33 ? Icons.paste
            : k == 34 ? Icons.rename : k == 35 ? Icons.trash : k == 36 ? Icons.folder-plus : k == 37 ? Icons.file-plus
            : k == 38 ? Icons.terminal : k == 39 ? Icons.info : k == 40 ? Icons.star : k == 41 ? Icons.link
            : k == 42 ? Icons.plus : k == 43 ? Icons.refresh : k == 44 ? Icons.eye : k == 46 ? Icons.settings
            : k == 47 ? Icons.folder-input : k == 48 ? Icons.sort : k == 49 ? Icons.grid : k == 50 ? Icons.list
            : k == 51 ? Icons.copy-plus : k == 52 ? Icons.hash : k == 53 ? Icons.package : k == 54 ? Icons.package-open
            : k == 55 ? Icons.code : k == 56 ? Icons.undo : k == 57 ? Icons.tag : k == 58 ? Icons.scan-eye
            : k == 59 ? Icons.pencil-line : k == 60 ? Icons.shield-check : k == 61 ? Icons.square-menu : k == 62 ? Icons.command
            : k == 63 ? Icons.columns3 : k == 64 ? Icons.languages : k == 65 ? Icons.keyboard
            : Icons.file;
    }

    // drop action code from Rust → DragAction
    public pure function act(a: int) -> DragAction {
        return a == 1 ? DragAction.copy : a == 2 ? DragAction.move : DragAction.none;
    }

    public pure function color(k: int) -> color {
        return k == 0 ? Theme.folder : k == 2 ? #4CC38A : k == 3 ? #A78BFA : k == 4 ? #F472B6 : k == 5 ? #F59E0B
            : k == 6 ? #60A5FA : k == 7 ? Theme.text-dim : k == 8 ? #22C55E : k == 9 ? #94A3B8 : k == 10 ? #38BDF8
            : k == 11 ? #F87171 : k == 12 ? #94A3B8
            : k >= 13 && k <= 29 ? Theme.accent
            : Theme.text-dim;
    }
}

