// SKJ Files — UI
// Original SKJ design. Icons: Lucide (ISC). Font: Inter (OFL). Built with Slint.

import { ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";

// ───────────────────────── data ─────────────────────────

export struct FileRow {
    name: string,
    kind: int,
    size: string,
    date: string,
    created: string,
    type-name: string,
    location: string,
    selected: bool,
    dim: bool,
    thumb: image,
    has-thumb: bool,
    tags: [color],
}

export struct ColRow {
    name: string,
    kind: int,
    dir: bool,
    sel: bool,
}

export struct ColData {
    title: string,
    rows: [ColRow],
    sel: int,
}

export struct TabInfo {
    title: string,
    kind: int,
}

export struct SideItem {
    label: string,
    kind: int,
    path: string,
    usage: float,
    sub: string,
    color: color,
}

export struct Crumb {
    label: string,
    index: int,
}

export struct MenuEntry {
    label: string,
    icon: int,
    action: string,
    separator: bool,
    danger: bool,
    shortcut: string,
    checked: bool,
}

export struct PropRow {
    key: string,
    value: string,
}

// ───────────────────────── theme ─────────────────────────

export global Theme {
    in-out property <bool> dark: true;
    in-out property <color> accent: #6C8CFF;
    out property <color> bg: dark ? #0E0F12 : #ECEEF2;
    out property <color> chrome: dark ? #16171C : #FFFFFF;
    out property <color> surface: dark ? #1A1C21 : #FFFFFF;
    out property <color> raised: dark ? #24272E : #F0F2F5;
    out property <color> menu-bg: dark ? #202228 : #FFFFFF;
    out property <color> hover: dark ? #FFFFFF10 : #0000000B;
    out property <color> press: dark ? #FFFFFF1C : #00000014;
    out property <color> border: dark ? #FFFFFF14 : #0000001C;
    out property <color> text: dark ? #ECEEF2 : #1A1C21;
    out property <color> text-dim: dark ? #A3A9B4 : #586070;
    out property <color> text-faint: dark ? #6E7480 : #949BA7;
    out property <color> selection: accent.with-alpha(dark ? 0.26 : 0.18);
    out property <color> selection-strong: accent.with-alpha(0.6);
    out property <color> danger: #F0565C;
    out property <color> folder: #F5B84A;
}

